{
  "name": "sotitout",
  "version": "0.1.0",
  "description": "Desktop daily-briefing and project-tracking assistant that reads your email and calendar.",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "brief": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.sotitout.app",
    "productName": "SotItOut",
    "files": ["dist/**/*", "package.json"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" }
  }
}
