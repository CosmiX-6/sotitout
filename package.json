{
  "name": "sotitout",
  "version": "0.2.0",
  "description": "Desktop daily-briefing and project-tracking assistant that reads your email and calendar.",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "brief": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build:mcp": "rm -rf mcp-dist && tsc -p tsconfig.mcp.json",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test:web": "node web/e2e/app.e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.sotitout.app",
    "productName": "SotItOut",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
